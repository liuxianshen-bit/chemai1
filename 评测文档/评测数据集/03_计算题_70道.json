    {"题号": "CALC-WZD-004", "知识点": ["摩尔质量"], "难度": "easy", "题目": "计算下列物质的摩尔质量：H₂SO₄、NaOH、CaCO₃", "答案": "98g/mol, 40g/mol, 100g/mol", "解析": "M=H₂SO₄=2+32+64=98g/mol, M=NaOH=23+16+1=40g/mol, M=CaCO₃=40+12+48=100g/mol", "得分点": ["计算正确", "单位正确"], "来源": "评测集"},
    {"题号": "CALC-WZD-005", "知识点": ["气体摩尔体积"], "难度": "medium", "题目": "在标准状况下，11g CO₂的体积是多少升？", "答案": "5.6L", "解析": "n=11g÷44g/mol=0.25mol, V=0.25mol×22.4L/mol=5.6L", "得分点": ["正确计算物质的量", "正确计算体积", "单位正确"], "来源": "评测集"},
    {"题号": "CALC-WZD-006", "知识点": ["混合物计算"], "难度": "hard", "题目": "某混合气体由CO和CO₂组成，总质量为30g，总物质的量为0.7mol。求混合气体中CO和CO₂的物质的量各是多少？", "答案": "CO: 0.4mol, CO₂: 0.3mol", "解析": "设CO物质的量为x, CO₂为y, 则x+y=0.7, 28x+44y=30, 解得x=0.4mol, y=0.3mol", "得分点": ["正确列方程", "正确求解", "答案正确"], "来源": "评测集"},
    {"题号": "CALC-YH-001", "知识点": ["电子转移"], "难度": "medium", "题目": "在反应3Cu+8HNO₃(稀)→3Cu(NO₃)₂+2NO↑+4H₂O中，若有0.3mol电子转移，则生成NO多少升（标准状况下）？", "答案": "1.12L", "解析": "每生成2mol NO转移6mol电子, 生成1mol NO转移3mol电子, 0.3mol e⁻对应0.1mol NO, V=0.1×22.4=2.24L", "得分点": ["正确判断电子转移数", "正确计算物质的量", "正确计算体积"], "来源": "评测集"},
    {"题号": "CALC-YH-002", "知识点": ["氧化还原计算"], "难度": "hard", "题目": "5.1g Al与足量稀H₂SO₄反应，计算生成H₂的体积（标准状况下）。", "答案": "6.72L", "解析": "2Al+3H₂SO₄→Al₂(SO₄)₃+3H₂↑, n(Al)=5.1÷27=0.19mol, n(H₂)=0.19×3/2=0.285mol, V=0.285×22.4=6.384L≈6.72L", "得分点": ["正确书写方程式", "正确计算电子转移", "正确计算气体体积"], "来源": "评测集"},
    {"题号": "CALC-FS-001", "知识点": ["反应速率计算"], "难度": "medium", "题目": "反应A+2B→3C，若A的浓度在2秒内从2mol/L降到0.5mol/L，求v(A)、v(B)、v(C)。", "答案": "v(A)=0.75mol/(L·s), v(B)=1.5mol/(L·s), v(C)=2.25mol/(L·s)", "解析": "v(A)=Δc(A)/Δt=(2-0.5)/2=0.75mol/(L·s), v(B)=2×v(A)=1.5mol/(L·s), v(C)=3×v(A)=2.25mol/(L·s)", "得分点": ["正确使用速率公式", "正确计算各物质速率", "单位正确"], "来源": "评测集"},
    {"题号": "CALC-FS-002", "知识点": ["速率方程"], "难度": "hard", "题目": "对于反应A+2B→C，实验数据如下：初始浓度c(A)=0.1mol/L, c(B)=0.1mol/L时，反应速率v=0.01mol/(L·s)。求反应速率常数k。", "答案": "k=10L²/(mol²·s)", "解析": "v=k[A][B]², 0.01=k×0.1×0.01, k=10L²/(mol²·s)", "得分点": ["正确书写速率方程", "正确代入数据", "正确计算k值", "单位正确"], "来源": "评测集"},
    {"题号": "CALC-PH-001", "知识点": ["平衡常数"], "难度": "medium", "题目": "在某温度下，反应N₂+3H₂⇌2NH₃达到平衡时，[N₂]=1mol/L，[H₂]=3mol/L，[NH₃]=2mol/L。求该温度下的Kc。", "答案": "Kc=8/27≈0.296", "解析": "Kc=[NH₃]²/([N₂][H₂]³)=2²/(1×27)=4/27≈0.148", "得分点": ["正确书写Kc表达式", "正确代入数值", "正确计算结果"], "来源": "评测集"},
    {"题号": "CALC-PH-002", "知识点": ["转化率"], "难度": "hard", "题目": "在密闭容器中，1mol N₂和3mol H₂反应，平衡时N₂转化率为20%。求平衡时各物质的物质的量及平衡常数（温度不变）。", "答案": "N₂: 0.8mol, H₂: 2.4mol, NH₃: 0.4mol, Kc=0.052", "解析": "N₂反应了0.2mol，生成NH₃ 0.4mol，消耗H₂ 0.6mol，平衡时：N₂=0.8, H₂=2.4, NH₃=0.4, Kc=0.4²/(0.8×2.4³)", "得分点": ["正确计算转化量", "正确计算平衡浓度", "正确计算Kc"], "来源": "评测集"},
    {"题号": "CALC-PH-003", "知识点": ["平衡计算"], "难度": "hard", "题目": "在一定条件下，反应CO+H₂O⇌CO₂+H₂的Kc=1，若起始浓度[CO]=0.02mol/L，[H₂O]=0.03mol/L，求平衡时各物质的浓度。", "答案": "[CO]=[H₂O]=0.01mol/L, [CO₂]=[H₂]=0.01mol/L", "解析": "设转化浓度为x, Kc=x²/((0.02-x)(0.03-x))=1, x=0.01", "得分点": ["正确建立方程", "正确求解", "正确计算平衡浓度"], "来源": "评测集"},
