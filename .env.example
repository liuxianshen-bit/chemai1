# ChemAI Backend Environment Configuration
# 复制此文件为.env并填写实际值

# ===================
# 通义千问API (LLM)
# ===================
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# 模型选择: qwen-turbo (快速/便宜) 或 qwen-plus (更强/更贵)
LLM_MODEL=qwen-turbo

# ===================
# 腾讯OCR API
# ===================
TENCENT_OCR_SECRET_ID=your_tencent_secret_id_here
TENCENT_OCR_SECRET_KEY=your_tencent_secret_key_here
TENCENT_OCR_REGION=ap-guangzhou

# ===================
# 数据库配置
# ===================
# SQLite (开发/MVP)
DATABASE_URL=sqlite:///./chemai.db

# MySQL (生产环境推荐)
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/chemai

# ===================
# Chroma向量数据库
# ===================
CHROMA_DB_PATH=./data/chromadb

# ===================
# 化学知识图谱
# ===================
KNOWLEDGE_GRAPH_PATH=./data/knowledge_graph
EXAM_QUESTIONS_PATH=./data/exam_questions

# ===================
# 应用配置
# ===================
DEBUG=true
APP_NAME=智辅化学 ChemAI
APP_VERSION=1.0.0

# ===================
# OCR配置
# ===================
OCR_CONFIDENCE_THRESHOLD=0.85
MAX_IMAGE_SIZE=10485760

# ===================
# 化学方程式审核配置
# ===================
BALANCE_CHECK_ENABLED=true
CONDITION_CHECK_ENABLED=true
PRODUCT_CHECK_ENABLED=true
STRUCTURE_CHECK_ENABLED=true

# ===================
# 障碍诊断默认值
# ===================
DEFAULT_CONCEPT_THRESHOLD=3
DEFAULT_READING_THRESHOLD=2
DEFAULT_EXPRESSION_THRESHOLD=3
DEFAULT_MASTERY_THRESHOLD=3

# ===================
# JWT密钥 (生产环境请务必修改)
# ===================
CHEMAI_JWT_SECRET=chemai-secret-key-change-in-production

# ===================
# CORS白名单 (生产环境请设置具体域名，逗号分隔)
# ===================
# CHEMAI_CORS_ORIGINS=http://localhost:8001,https://yourdomain.com

# ===================
# 服务端口
# ===================
# CHEMAI_PORT=8001
